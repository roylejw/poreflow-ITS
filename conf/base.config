/*
 * Default resources per process label. Requests are capped by
 * params.max_cpus / max_memory / max_time (process.resourceLimits).
 * Failed tasks are retried once with more memory and time.
 */

process {
    cpus   = 1
    memory = 4.GB
    time   = 2.h

    errorStrategy = { task.exitStatus in [104, 134, 137, 139, 140, 143, 247] ? 'retry' : 'finish' }
    maxRetries    = 1

    withLabel: process_low {
        cpus   = 2
        memory = { 4.GB * task.attempt }
        time   = { 2.h * task.attempt }
    }
    withLabel: process_medium {
        cpus   = 8
        memory = { 16.GB * task.attempt }
        time   = { 12.h * task.attempt }
    }
    withLabel: process_high {
        cpus   = 16
        memory = { 64.GB * task.attempt }
        time   = { 24.h * task.attempt }
    }
    // pooled clustering is the longest step on large runs (still capped by params.max_time)
    withName: 'CLUSTER' {
        time   = { 72.h * task.attempt }
    }
    withLabel: process_gpu {
        cpus           = 6
        memory         = { 32.GB * task.attempt }
        time           = { 8.h * task.attempt }
        // the general options plus, with --gpu, the GPU request (a withLabel setting replaces the general one)
        clusterOptions = { [params.cluster_options, (params.gpu as String) == 'true' ? params.gpu_cluster_options : ''].findAll { o -> o }.join(' ') }
        containerOptions = { (params.gpu as String) == 'true' ? (workflow.containerEngine == 'docker' ? '--gpus all' : '--nv') : '' }
    }
}
