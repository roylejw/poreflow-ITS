/*
 * Example site configuration - copy, edit, and pass with -c:
 *   nextflow run main.nf -profile slurm,conda -c my_site.config -params-file my_params.yaml
 *
 * Only settings specific to your cluster belong here; analysis settings go in
 * the params file.
 */

params {
    cluster_options     = ''          // added to every job, e.g. '--account=myproject'
    gpu                 = true        // polish with medaka on a GPU
    gpu_cluster_options = '--gpus-per-node=1'   // SLURM; e.g. '--gres=gpu:1', or PBS '-l select=1:ngpus=1'
}

process {
    resourceLimits = [cpus: 32, memory: 256.GB, time: 72.h]   // largest job your cluster allows
    // queue      = 'compute'             // default partition/queue
    // use params.cluster_options (above) for the account: it also reaches the GPU job

    withLabel: process_gpu {
        // queue = 'gpu'                  // if GPUs live in a separate partition
    }
}

// Nextflow's work folder must be on storage shared by all compute nodes (never a
// node-local disk such as /local or an interactive job's $TMPDIR). Each task still
// runs in fast node-local scratch (process.scratch = true in the HPC profiles).
// workDir = '/shared/project/space/nf_work'

executor {
    queueSize       = 50                  // max jobs submitted at once
    submitRateLimit = '10/1min'
}

// Reuse conda environments between runs (create once, shared by all runs)
conda.cacheDir = "${System.getenv('HOME')}/.nextflow/conda"
// singularity.cacheDir = "${System.getenv('HOME')}/.nextflow/singularity"
