/*
 * Small end-to-end test:
 *   bash tests/make_test_data.sh <reads_dir> <reference.fasta>   (once; see tests/README.md)
 *   nextflow run main.nf -profile test,<software>
 */
params {
    input          = "${projectDir}/tests/data/samplesheet.csv"
    db             = "${projectDir}/tests/data/test_db.fasta"
    outdir         = 'results_test'
    itsx_taxa      = 'F'
}
process {
    executor       = 'local'
    resourceLimits = [cpus: 4, memory: 8.GB, time: 2.h]
}
