/*
 * Where each step publishes its outputs (under params.outdir).
 */

process {
    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].toLowerCase()}" },
        mode: 'copy',
        saveAs: { filename -> filename == 'versions.yml' ? null : filename }
    ]

    withName: 'PREPROCESS' {
        publishDir = [
            path: { "${params.outdir}/01_preprocess/${sample}" },
            mode: 'copy',
            saveAs: { filename -> filename == 'versions.yml' ? null : filename }
        ]
    }
    withName: 'PER_READ_SINTAX' {
        publishDir = [path: { "${params.outdir}/01_preprocess/${sample}" }, mode: 'copy',
                      saveAs: { filename -> filename == 'versions.yml' ? null : filename }]
    }
    withName: 'CLUSTER' {
        publishDir = [path: { "${params.outdir}/02_cluster" }, mode: 'copy',
                      saveAs: { filename -> filename in ['versions.yml', 'clusters'] ? null : filename }]
    }
    withName: 'POLISH' {
        publishDir = [path: { "${params.outdir}/03_polish" }, mode: 'copy',
                      saveAs: { filename -> filename == 'versions.yml' ? null : filename }]
    }
    withName: 'MERGE_OTUS|ITSX|CHIMERA|SINTAX' {
        publishDir = [path: { "${params.outdir}/04_taxonomy" }, mode: 'copy',
                      saveAs: { filename -> filename == 'versions.yml' ? null : filename }]
    }
    withName: 'OTU_TABLE' {
        publishDir = [path: { "${params.outdir}/results" }, mode: 'copy',
                      saveAs: { filename -> filename == 'versions.yml' ? null : filename }]
    }
}
