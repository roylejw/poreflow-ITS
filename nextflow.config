/*
 * poreflow-ITS - full-length ITS metabarcoding of Oxford Nanopore amplicon reads
 *
 * Run settings go in a params file (see params.example.yaml):
 *     nextflow run main.nf -params-file my_params.yaml -profile <executor>,<software>
 * Site-specific settings (queue, account, GPU flags) go in a small config file
 * passed with -c (see conf/site_example.config).
 */

manifest {
    name            = 'poreflow-ITS'
    description     = 'Full-length ITS (ITS1-5.8S-ITS2) metabarcoding of Oxford Nanopore amplicon reads'
    version         = '0.2.0'
    license         = 'GPL-3.0-or-later'
    mainScript      = 'main.nf'
    nextflowVersion = '!>=24.10.0'
}

params {
    // ---- Input / output ----------------------------------------------------
    input                 = null      // samplesheet (CSV/TSV: sample,reads) or a folder of reads
    outdir                = 'results'
    db                    = null      // SINTAX-formatted reference FASTA (e.g. EUKARYOME, UNITE)

    // ---- Primers and target region (5'->3') ----------------------------------
    primer_fwd            = 'ACCWGCGGARGGATCATTA'   // SSU 3' end -> ITS1
    primer_rev            = 'TCCTGAGGGAAACTTCG'     // LSU
    its_end_site          = 'GCATATCAATAAGCGGAGGA'  // reverse complement of ITS4; reads are cut here
    primer_error          = 0.15
    require_rev_primer    = false     // false: only the 5' primer is required (3' trimmed if present)

    // ---- Read filtering ----------------------------------------------------
    min_amplicon_len      = 1000      // after primer trimming (whole amplicon)
    max_amplicon_len      = 2500
    min_its_len           = 300       // after cutting at its_end_site
    max_its_len           = 1500
    min_read_q            = 20        // mean read quality (from mean error probability)

    // ---- Clustering, polishing, merging --------------------------------------
    cluster_id            = 0.97      // vsearch --cluster_smallmem identity on quality-sorted reads
    min_cluster_size      = 5
    max_reads_per_cluster = 1000      // highest-quality members used for polishing
    medaka_model          = 'r1041_e82_400bps_hac_v5.2.0'   // must match the basecalling model
    merge_id              = 0.97      // re-cluster polished consensus OTUs (1 = no merging)

    // ---- Taxonomy -------------------------------------------------------------
    tax_query_cov         = 0.9
    tophit_chunk_size     = 1000      // OTUs per best-hit search job (jobs run in parallel)
    sintax_cutoff         = 0.8
    sintax_seed           = 1         // fixed seed, so SINTAX confidences are the same in every run
    itsx_taxa             = 'all'     // ITSx -t (e.g. 'F' for fungi only)
    per_read_tax          = false     // also classify every read with SINTAX (slow)

    // ---- Compute ---------------------------------------------------------------
    gpu                   = false     // run medaka on a GPU
    cluster_options       = ''        // added to every scheduler job, e.g. '--account=myproject'
    gpu_cluster_options   = ''        // added to the GPU job only, e.g. '--gpus-per-node=1' or '--gres=gpu:1'
    copy_inputs_to_scratch = false    // copy (not symlink) inputs into node-local scratch
    max_cpus              = 16
    max_memory            = '64.GB'
    max_time              = '48.h'

    // ---- Software ---------------------------------------------------------------
    conda_main            = null      // existing conda env (name or path) instead of envs/main.yml
    conda_medaka          = null      // existing conda env instead of envs/medaka.yml
    container_main        = 'ghcr.io/roylejw/poreflow-its-main:0.2.0'     // published by .github/workflows/containers.yml
    container_medaka      = 'ghcr.io/roylejw/poreflow-its-medaka:0.2.0'

    help                  = false
}

process {
    resourceLimits = [cpus: params.max_cpus, memory: params.max_memory, time: params.max_time]
    stageInMode    = (params.copy_inputs_to_scratch as String) == 'true' ? 'copy' : 'symlink'
    clusterOptions = { params.cluster_options }
    errorStrategy  = 'finish'
}

includeConfig 'conf/base.config'
includeConfig 'conf/modules.config'

profiles {
    // ---- Executors -------------------------------------------------------------
    local {
        process.executor = 'local'
    }
    slurm {
        process.executor = 'slurm'
        process.scratch  = true          // run each task in the node's $TMPDIR
    }
    pbs {
        process.executor = 'pbspro'
        process.scratch  = true
    }
    sge {
        process.executor = 'sge'
        process.penv     = 'smp'
        process.scratch  = true
    }
    lsf {
        process.executor = 'lsf'
        process.scratch  = true
    }

    // ---- Software ----------------------------------------------------------------
    conda {
        conda.enabled          = true
        docker.enabled         = false
        singularity.enabled    = false
        apptainer.enabled      = false
    }
    mamba {
        conda.enabled          = true
        conda.useMamba         = true
        docker.enabled         = false
        singularity.enabled    = false
        apptainer.enabled      = false
    }
    docker {
        docker.enabled         = true
        docker.runOptions      = '-u $(id -u):$(id -g)'
        conda.enabled          = false
        singularity.enabled    = false
        apptainer.enabled      = false
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        conda.enabled          = false
        docker.enabled         = false
        apptainer.enabled      = false
    }
    apptainer {
        apptainer.enabled      = true
        apptainer.autoMounts   = true
        conda.enabled          = false
        docker.enabled         = false
        singularity.enabled    = false
    }
    wave {
        // containers built on the fly from envs/*.yml (needs internet access)
        wave.enabled           = true
        wave.strategy          = 'conda'
        conda.enabled          = false
    }

    // ---- Small end-to-end test -----------------------------------------------------
    test {
        includeConfig 'conf/test.config'
    }
}

// Disable user site-packages (~/.local) so they cannot shadow the pipeline's Python packages
env {
    PYTHONNOUSERSITE = '1'
}

timeline {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/timeline.html"
}
report {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/report.html"
}
trace {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/trace.tsv"
}
