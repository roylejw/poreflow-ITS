# poreflow-ITS main environment (built from envs/main.yml)
#   docker build -f containers/Dockerfile.main -t poreflow-its-main:0.1.1 .      (run from the repository root)
FROM mambaorg/micromamba:2.0.5
# ps is used by Nextflow to record task CPU and memory use
USER root
RUN apt-get update && apt-get install -y --no-install-recommends procps && rm -rf /var/lib/apt/lists/*
USER $MAMBA_USER
COPY --chown=$MAMBA_USER:$MAMBA_USER envs/main.yml /tmp/env.yml
RUN micromamba install -y -n base -f /tmp/env.yml && micromamba clean --all --yes
ENV PATH=/opt/conda/bin:$PATH PYTHONNOUSERSITE=1
